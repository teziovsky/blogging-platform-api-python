{
  "languages": {
    "Python": {
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
      "language_servers": ["ruff", "!oxlint", "!oxfmt", "!graphql", "!biome", "!stylelint-lsp", "..."],
    },
  },
}
